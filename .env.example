# Trello: usar OAuth 2.0 Bearer cuando esté disponible.
TRELLO_ACCESS_TOKEN=

# Compatibilidad con autenticación legacy (usar sólo si no hay access token).
TRELLO_API_KEY=
TRELLO_TOKEN=

# Lista "Nuevos leads" de NEW EVOLUTION — Marketing & CRM.
# El código ya tiene este ID como fallback; se deja acá para facilitar cambios.
TRELLO_LIST_ID=6abab828d0452e1269349622
